
@model IEnumerable<MyMvcApp.Models.Student>

@{
    ViewData["Title"] = "Kenneth Velasco | Portfolio";
}

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        scroll-behavior: smooth;
    }

    body {
        background: #fffbed;
        color: #172b40;
        font-family: Georgia, 'Times New Roman', serif;
    }

    .portfolio {
        width: 100%;
        min-height: 100vh;
    }

    /* HOME SECTION */

    .home-section {
        min-height: 350px;
        display: grid;
        grid-template-columns: 46% 54%;
        background: #fffbed;
        border-bottom: 1px solid #aaa995;
    }

    .home-left {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 35px;
        border-right: 1px solid #aaa995;
    }

    .illustration-frame {
        width: 180px;
        height: 280px;
        border: 1px solid #858474;
        padding: 4px;
        border-radius: 100px 100px 0 0;
        overflow: hidden;
    }

    .illustration-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        border-radius: 100px 100px 0 0;
    }

    .home-right {
        display: grid;
        grid-template-rows: 2fr 1fr;
    }

    .name-container {
        display: flex;
        align-items: center;
        padding: 35px;
        border-bottom: 1px solid #aaa995;
    }

    .name-container h1 {
        font-size: clamp(38px, 6vw, 55px);
        font-weight: 400;
        line-height: .95;
        letter-spacing: -2px;
    }

    .intro-container {
        display: flex;
        align-items: center;
        padding: 25px 35px;
    }

    .intro-container p {
        font-size: 12px;
        line-height: 1.4;
        max-width: 350px;
    }

    /* CONTACT SECTION */

    .contact-section {
        min-height: 350px;
        display: grid;
        grid-template-columns: 34% 66%;
        background: #9caf98;
        color: #fffbed;
    }

    .contact-left {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-right: 1px solid rgba(255, 251, 237, .65);
        padding: 30px;
    }

    .profile-photo {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        border: 1px solid #52694f;
        padding: 3px;
        object-fit: cover;
    }

    .contact-heading {
        position: absolute;
        bottom: 22px;
        left: 30px;
        font-size: 29px;
        font-weight: 400;
    }

    .contact-heading em {
        font-style: italic;
    }

    .contact-right {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 40px 0;
    }

    .contact-row {
        display: grid;
        grid-template-columns: 110px 1fr;
        align-items: center;
        min-height: 43px;
        padding: 8px 35px;
        border-top: 1px solid rgba(255, 251, 237, .55);
        font-size: 12px;
    }

    .contact-row:last-child {
        border-bottom: 1px solid rgba(255, 251, 237, .55);
    }

    .contact-label {
        font-style: italic;
        color: #fff2d6;
    }

    .contact-row a {
        color: #fffbed;
        text-decoration: none;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .contact-row a:hover {
        text-decoration: underline;
    }

    /* RESPONSIVE DESIGN */

    @@media (max-width: 650px) {
        .home-section {
            grid-template-columns: 1fr;
        }

        .home-left {
            border-right: none;
            border-bottom: 1px solid #aaa995;
            min-height: 320px;
        }

        .home-right {
            min-height: 250px;
        }

        .name-container {
            padding: 30px;
        }

        .intro-container {
            padding: 25px 30px;
        }

        .contact-section {
            grid-template-columns: 1fr;
        }

        .contact-left {
            min-height: 320px;
            border-right: none;
            border-bottom: 1px solid rgba(255, 251, 237, .65);
        }

        .contact-heading {
            left: 0;
            width: 100%;
            text-align: center;
        }

        .contact-right {
            padding: 30px 0;
        }

        .contact-row {
            grid-template-columns: 85px 1fr;
            padding: 12px 20px;
        }
    }
</style>

<div class="portfolio">

    <!-- PAGE 1: HOME -->

    <section class="home-section" id="home">

        <div class="home-left">
            <div class="illustration-frame">
                <img src="~/images/profile-illustration.png"
                     asp-append-version="true"
                     alt="Kenneth Velasco illustration" />
            </div>
        </div>

        <div class="home-right">

            <div class="name-container">
                <h1>
                    Kenneth<br />
                    Velasco
                </h1>
            </div>

            <div class="intro-container">
                <p>
                    I am an aspiring full developer, currently a
                    second year BS Computer Science student from
                    the Polytechnic University of the Philippines.
                </p>
            </div>

        </div>

    </section>

    <!-- PAGE 2: CONTACT -->

    <section class="contact-section" id="contact">

        <div class="contact-left">

            <img src="~/images/profile-photo.jpg"
                 asp-append-version="true"
                 alt="Kenneth Velasco"
                 class="profile-photo" />

            <h2 class="contact-heading">
                Get in <em>touch</em>
            </h2>

        </div>

        <div class="contact-right">

            <div class="contact-row">
                <span class="contact-label">Email</span>

                <a href="mailto:velascokenneth0528@gmail.com">
                    velascokenneth0528@gmail.com
                </a>
            </div>

            <div class="contact-row">
                <span class="contact-label">GitHub</span>

                <a href="https://github.com/kennethvelasco-dev"
                   target="_blank"
                   rel="noopener noreferrer">
                    https://github.com/kennethvelasco-dev
                </a>
            </div>

            <div class="contact-row">
                <span class="contact-label">LinkedIn</span>

                <a href="https://www.linkedin.com/in/kenneth-velasco-b45f53234/"
                   target="_blank"
                   rel="noopener noreferrer">
                    https://www.linkedin.com/in/kenneth-velasco-b45f53234/
                </a>
            </div>

        </div>

    </section>

</div>